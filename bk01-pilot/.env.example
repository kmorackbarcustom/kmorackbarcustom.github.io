# KMO BK01 pilot environment template — never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-kmo-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-kmo-publishable-or-anon-key
NEXT_PUBLIC_ADMIN_SITE_URL=https://admin-booking.example.com
NEXT_PUBLIC_BOOKING_SITE_URL=https://booking.example.com
NEXT_PUBLIC_DEFAULT_SHOP_SLUG=kmo-rackbarcustom
NEXT_PUBLIC_ATTRIBUTION_ENABLED=true
NEXT_PUBLIC_ATTRIBUTION_URL=https://by.wstera.com
NEXT_PUBLIC_ATTRIBUTION_TEXT=Powered by WSTERA

# KMO-owned LINE / notification integration. Server-only.
NEXT_PUBLIC_CENTRAL_LINE_OA_ID=@your-kmo-line-oa
LINE_CHANNEL_SECRET=your-kmo-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-kmo-line-channel-access-token
LINE_MERCHANT_CHANNELS_JSON={"shop-uuid":{"channelSecret":"line-channel-secret","accessToken":"line-access-token"}}
NOTIFICATION_DISPATCH_SECRET=replace-with-a-long-random-secret
SUPABASE_SERVICE_ROLE_KEY=your-kmo-service-role-key
